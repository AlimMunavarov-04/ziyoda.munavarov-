[Unit]
Description=Menschen A1.1 (ziyoda.munavarovbi.com)
After=network.target

[Service]
User=planner
Group=planner
WorkingDirectory=/var/www/ziyoda/server
Environment=ZIYODA_DATA=/home/planner/ziyoda-data
ExecStart=/var/www/ziyoda/.venv/bin/gunicorn -w 2 -b 127.0.0.1:8097 --pid /home/planner/ziyoda-data/gunicorn.pid app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
